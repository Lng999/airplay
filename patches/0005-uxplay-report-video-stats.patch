                                              (gpointer) loop);
+    guint video_stats_id = g_timeout_add_seconds(1, (GSourceFunc) video_stats_callback,
+                                                 (gpointer) loop);
 
 #ifdef _WIN32
     gmainloop = loop;
@@ -791,6 +835,7 @@ static void main_loop()  {
     if (video_eos_watch_id > 0) g_source_remove(video_eos_watch_id);
